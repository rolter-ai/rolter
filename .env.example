# copy to .env and adjust.
#
# for a *production* deployment, do not hand-fill this file: `rolter init`
# generates it with fresh secrets, and `rolter check --strict` gates the result.
# see docs/deployment/preflight-validation.md. this example is the local shape.

# logging filter
RUST_LOG=info

# gateway (data plane)
ROLTER_CONFIG=rolter.toml
ROLTER_HOST=0.0.0.0
ROLTER_PORT=4000

# control plane (management api + ui host)
# the binary defaults to 127.0.0.1; binding another interface with no
# ROLTER_ADMIN_TOKEN below is refused, because that serves a management api
# anyone can reach as superadmin
ROLTER_CONTROL_HOST=0.0.0.0
ROLTER_CONTROL_PORT=4001
ROLTER_UI_DIR=ui/dist

# master key for envelope-encrypting provider secrets at rest (aes-256-gcm kek)
# generate with: openssl rand -hex 32, or let `rolter init` do it.
# when unset the control plane stores provider credentials UNSEALED with only a
# log warning — `rolter check` treats it as fatal for exactly that reason.
ROLTER_KEK=

# bearer token for the management api and /internal/snapshot; unauthenticated
# without it — every request is then served as superadmin, which is why the
# control plane refuses to bind anything but loopback while it is empty
ROLTER_ADMIN_TOKEN=

# acknowledge serving an unauthenticated management api on a non-loopback
# address. only for a local stack on a network you control; setting a token
# above is the answer everywhere else
ROLTER_ALLOW_OPEN_MODE=

# shared secret between the control plane and the gateways polling its snapshot
ROLTER_INTERNAL_TOKEN=

# deployment-wide pepper mixed into virtual-key digests. must be identical on
# every replica, and must not change once keys have been issued
ROLTER_KEY_PEPPER=

# upstream provider keys referenced by api_key_env in the config
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# datastores (used by the control plane and logging; not required for the gateway mvp)
DATABASE_URL=postgres://rolter:rolter@localhost:5432/rolter
REDIS_URL=redis://localhost:6379
CLICKHOUSE_URL=http://localhost:8123

# control-plane postgres connection pool (#1052). one pool serves everything:
# /internal/snapshot (polled by every gateway), the whole dashboard CRUD
# surface, SCIM, SSO, MCP and the RBAC guard's per-request membership lookups.
# the defaults below are what rolter used before these were configurable, so
# leaving them unset changes nothing.
#
# size ROLTER_DB_MAX_CONNECTIONS against the database's own max_connections
# divided across control replicas, not against gateway count — snapshot polls
# are short and 304 most of the time. raise it when acquire waits show up on
# rolter_db_pool_acquire_ms while rolter_db_pool_idle sits at zero.
# ROLTER_DB_MAX_CONNECTIONS=10
# ROLTER_DB_MIN_CONNECTIONS=0
# how long a request waits for a free connection before failing. bounded so
# pool exhaustion is a fast, attributable error rather than an opaque stall
# ROLTER_DB_ACQUIRE_TIMEOUT_SECS=30
# 0 on either of these means "never expire"
# ROLTER_DB_IDLE_TIMEOUT_SECS=600
# ROLTER_DB_MAX_LIFETIME_SECS=1800

# failed-login throttling (#1079). the login endpoint runs an argon2id
# verification per request, so an unthrottled one is both a guessing oracle and
# a cheap way to burn the control plane's cpu. counters live in redis when
# ROLTER_REDIS_URL is set, and are process-local otherwise — with several
# replicas and no redis, each replica holds its own budget
# ROLTER_LOGIN_MAX_FAILURES=5
# ROLTER_LOGIN_IP_MAX_FAILURES=50
# ROLTER_LOGIN_FAILURE_WINDOW_SECS=900
# ROLTER_LOGIN_LOCK_SECS=60
# ROLTER_LOGIN_MAX_LOCK_SECS=900
# ROLTER_LOGIN_MAX_DELAY_MS=2000
# only behind a proxy that overwrites the header: an unverified X-Forwarded-For
# gives an attacker unlimited budgets and the ability to spend someone else's
# ROLTER_LOGIN_TRUST_FORWARDED_FOR=false
# ROLTER_LOGIN_THROTTLE_DISABLED=false

# update check (#901, #902). the control plane asks github for the latest
# stable release once at boot and every six hours (one 5 s request carrying
# nothing but a user-agent) so the dashboard footer can hint at a newer
# version, and the `rolter` cli prints a one-line stderr notice at most once a
# day. offline is silent. set this to false in an air-gapped deployment or a
# script that must make no outbound call at all.
# ROLTER_UPDATE_CHECK=false

# telemetry kill switch (#812). one explicit off for every signal — traces,
# metrics and the dashboard's browser tracing — regardless of which OTEL_*
# endpoints below are set. unset means enabled, which changes nothing: with no
# endpoint configured nothing is exported anyway. set this when you need "no
# telemetry leaves this deployment" to be a single stated fact rather than a
# property of remembering to leave several variables unset.
# it can only subtract: it never turns export on by itself.
# ROLTER_TELEMETRY_ENABLED=false

# opentelemetry (#805). unset by default: with no endpoint the gateway exports
# nothing, installs no propagator, and its hot path is unchanged. the
# observability overlay sets these for the compose services already —
#   docker compose -f docker/docker-compose.yml \
#                  -f docker/docker-compose.observability.yml up
# these values are for running rolter on the host against that overlay.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=rolter-gateway
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# sampling: unset means always-on. use e.g. traceidratio with
# OTEL_TRACES_SAMPLER_ARG=0.1 to sample 10% of traces under real load
# OTEL_TRACES_SAMPLER=parentbased_always_on

# metrics ride the same endpoint as traces (#805). the Prometheus endpoint is
# untouched — this is a second exporter over the same numbers, so a deployment
# already sending traces to a collector gets its metrics there too. set the
# metrics-specific endpoint only to split the two destinations.
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4317
# how often the SDK reads the gateway's counters, in milliseconds (default 60000)
# OTEL_METRIC_EXPORT_INTERVAL=60000

# logs over OTLP (#809). rides the same endpoint as traces and metrics; set the
# logs-specific one only to split destinations. this is *additive* — stdout
# stays the default, so `docker logs` shows exactly what it always did and the
# collector additionally receives the same records, carrying trace_id/span_id so
# a log joins the trace it came from.
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4317

# resource attributes identifying this process to every backend (#809).
# service.version comes from the crate version automatically, and
# OTEL_RESOURCE_ATTRIBUTES is honoured by the SDK for anything else.
# service.instance.id: the same identity the cluster inventory records, so a
# node in `cluster_nodes` and a node in the trace backend are the same node.
# falls back to HOSTNAME; omitted entirely when neither is set.
# ROLTER_NODE_ID=gateway-0
# separates staging noise from production signal
# ROLTER_ENVIRONMENT=production

# browser tracing for the dashboard (#805). the SPA is built ahead of time, so
# the control plane injects this into the served html as window.__ROLTER_CONFIG__
# rather than baking it in at build time. unset by default: with no endpoint the
# dashboard loads no tracing SDK at all and sends no extra headers.
# this is deliberately NOT OTEL_EXPORTER_OTLP_ENDPOINT above — that one is the
# backend's gRPC exporter, whereas a browser needs an OTLP/HTTP endpoint that is
# reachable from the user's machine, not from inside the cluster.
# ROLTER_UI_OTEL_ENDPOINT=http://localhost:4318/v1/traces
# ROLTER_UI_OTEL_SERVICE_NAME=rolter-ui

# signoz MCP server (docker-compose.signoz.yml). create the key in the SigNoz UI
# under Settings -> API Keys and keep it out of tracked files:
#   set -x SIGNOZ_API_KEY (pass show rolter/signoz-api-key)
# SIGNOZ_API_KEY=
