# ui/ has its own prettier config, ignore file and `format:check` step; the
# root run must not reach into it or the two would disagree on every file
ui/

# vendored, generated or machine-owned trees
node_modules
docs/dev-docs/book/
target/
.worktrees/

# release-plz regenerates these on every release; formatting them once only
# means fighting the generator forever
crates/*/CHANGELOG.md

# a symlink to AGENTS.md: prettier would format the same bytes twice
CLAUDE.md

# written by the rolter-control test suite with serde_json, which owns its
# formatting: the test compares it byte for byte (#1369), so prettier collapsing
# a short array such as `chain_at`'s would fail cargo test
crates/rolter-control/rbac-matrix.json

# written by the rolter-control test suite with serde_json, which owns its
# formatting: the test compares it byte for byte with the rendering of
# EXCLUSION_REASONS (#3423), like rbac-matrix.json above
crates/rolter-control/savings-reasons.json

# rewritten by rolter-core's snapshot shape guard with serde_json whenever
# ROLTER_TEST_UPDATE_SNAPSHOT_SHAPE is set (ADR-0038); a regeneration that had
# to be followed by a prettier run would fail the docs gate every time
crates/rolter-core/tests/fixtures/snapshot_shape.json

# helm chart templates are go templates that happen to end in .yaml, and the
# yaml parser cannot read `{{- if ... }}` at all
charts/rolter/templates/

# the scheduled Jules agents keep their own learning journals here and append
# to them from environments that do not run prettier; an unformatted entry
# would fail the docs gate on every one of their PRs, and nothing reads these
# files but the agents themselves
.Jules/

# the vendored model price catalogue (#966): written by
# scripts/refresh-price-catalogue.ts as one compact line per run so a refresh
# diffs as a whole snapshot, and the file is data nothing reads for style
crates/rolter-control/catalogue/

# rewritten by examples/rolter-linear-trainer with json.dumps whenever
# ROLTER_TEST_REGENERATE_GOLDEN is set (#3455); a regeneration that had to be
# followed by a prettier run would fail the docs gate every time
crates/rolter-gateway/tests/fixtures/local_classifier/golden_features.json
