# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# local runtime config — copy rolter.example.toml to rolter.toml and adjust.
# kept out of git so deployments don't clobber it and no secrets leak in
rolter.toml

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

# mdbook build output (contributor docs); source is docs/*.md
docs/book/
ui/storybook-static/

# Local output from the optional CPU inference-engine smoke/benchmark suite.
artifacts/engines/

# machine-specific Claude Code preview launch config
.claude/launch.json

# transient git worktrees created for isolated background agent runs
.claude/worktrees/

# machine-specific Warp terminal state
.warp/

# macOS Finder metadata
.DS_Store

# merge/patch leftovers — never part of a change (#787 committed three)
*.orig
*.rej

# local environment files — `.env.example` is the tracked template and tells
# developers to create these, which carry provider keys and SIGNOZ_API_KEY
.env
.env.*
!.env.example

# agent worktrees — `worktree-path` in the worktrunk user config puts every
# worktree under the repo it belongs to instead of a sibling directory, so the
# checkout contains its own worktrees and must not try to track them
.worktrees/

# storybook writes this next to `ui/` whenever a dev-server boot fails
ui/debug-storybook.log

# dogfooding stack (#924): the KEK and virtual key are generated per machine by
# `just dogfood`. the *fleet* keys in integration/dogfood/keys.env are checked
# in on purpose — these two are not, because they are per-run state, not fixtures
integration/dogfood/.kek
integration/dogfood/.virtual-key

# test-run leftovers — #1300 committed seven playwright/storybook recordings
# and a dev-server log (#1317). playwright's own output goes to
# ui/e2e/.output (ignored in ui/.gitignore); anything that still lands at the
# root is never part of a change
videos/
*.webm
*.log
