# One development credential, shared by every local service that has a human
# login (#956). Sourced by the justfile, the SigNoz provisioning script and the
# sheet, so there is exactly one place to change it.
#
# LOCAL ONLY. This is checked in, printed to the console on every `just
# dogfood`, and protects nothing. It is safe precisely because the stack it
# unlocks binds to loopback, serves fake providers and holds no real data.
# Never reuse it anywhere reachable, and never copy these values into
# `docker/docker-compose.yml`, the Helm chart or any deployed configuration —
# those keep their own defaults on purpose.

# the login for the rolter dashboard and for SigNoz
# SigNoz refuses a password without an upper-case letter, a lower-case
# letter, a digit and a symbol (12+ chars), and then has no account at all
DEV_EMAIL=dev@rolter.local
DEV_PASSWORD=Rolter-dev-2026
# quoted: this file is `source`d, so an unquoted value with a space is parsed
# as a command
DEV_NAME="rolter dev"

# postgres. changing this does not re-key an existing volume: postgres only
# applies POSTGRES_PASSWORD when it initialises an empty data directory, so an
# already-created database keeps whatever it was built with. `just dev-creds`
# runs an ALTER USER to bring an existing volume in line.
DEV_PG_USER=rolter
DEV_PG_PASSWORD=rolter

# redis, clickhouse and the OTLP collector run without authentication locally.
# recorded here so the sheet can state it rather than leaving it unanswered.
DEV_REDIS_AUTH=none
DEV_CLICKHOUSE_USER=default
DEV_CLICKHOUSE_PASSWORD=none
DEV_OTLP_AUTH=none
